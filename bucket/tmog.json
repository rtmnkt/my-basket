{
    "version": "1.1.1",
    "description": "Native Windows task manager and system performance monitor",
    "homepage": "https://tmog.org/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://tmog.org/downloads/TMOG-Task-Manager-Setup-1.1.1-0-x64-07a2175da549.zip?v=1.1.1-07a2175da549db7f39e18fd14eb059b9dbca83225b740c1660f83fdf444d4b75",
            "hash": "07a2175da549db7f39e18fd14eb059b9dbca83225b740c1660f83fdf444d4b75"
        }
    },
    "installer": {
        "script": [
            "$setup = Get-ChildItem -Path $dir -Filter 'TMOG-Task-Manager-Setup*.exe' -File -Recurse | Select-Object -First 1",
            "if (-not $setup) { throw 'TMOG installer EXE not found inside the downloaded ZIP.' }",
            "$unpack = Join-Path $dir '_scoop_unpack'",
            "New-Item -Path $unpack -ItemType Directory -Force | Out-Null",
            "Expand-InnoArchive -Path $setup.FullName -DestinationPath $unpack",
            "$appExe = Get-ChildItem -Path $unpack -Filter 'Task Manager.exe' -File -Recurse | Select-Object -First 1",
            "if (-not $appExe) {",
            "    $found = @(Get-ChildItem -Path $unpack -Filter '*.exe' -File -Recurse | Select-Object -ExpandProperty FullName)",
            "    throw ('Task Manager.exe not found after extracting Inno Setup. Executables: ' + ($found -join '; '))",
            "}",
            "Get-ChildItem -LiteralPath $appExe.DirectoryName -Force | ForEach-Object { Copy-Item -LiteralPath $_.FullName -Destination $dir -Recurse -Force }",
            "if (-not (Test-Path -LiteralPath (Join-Path $dir 'Task Manager.exe') -PathType Leaf)) { throw 'Task Manager.exe could not be copied into the Scoop app directory.' }",
            "Remove-Item -LiteralPath $unpack -Recurse -Force",
            "Remove-Item -LiteralPath $setup.FullName -Force"
        ]
    },
    "shortcuts": [
        [
            "Task Manager.exe",
            "Task Manager TMOG"
        ]
    ],
    "bin": [
        [
            "Task Manager.exe",
            "tmog"
        ]
    ]
}
